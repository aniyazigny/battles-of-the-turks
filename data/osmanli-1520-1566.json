   "loc": "known = yer biliniyor; approx = yaklaşık; region = yalnızca bölge düzeyinde.",
   "verify": "tdvia = TDV İslâm Ansiklopedisi maddesinde doğrulandı; wp = Wikipedia'da var; rom = 'Where the Romans Fought' veri setinde karşılığı var; academic = bağımsız akademik ikincil kaynakla kontrol edildi (Haldon, Hillenbrand, Peacock, Bosworth vb.). tdvia2 = olay ikinci, ayrı bir TDVİA maddesinde de doğrulandı (iki madde kuralı).",
   "state": "Savaşan Türk devleti. home_batch: kaydın nihai olarak ait olduğu araştırma partisi.",
   "opp_state": "Yalnızca turk_arasi kayıtlarda: karşı taraftaki kapsam içi Türk devleti. Kayıt o devletin tablosunda ters sonuçla görünür (K1)."
  },
  "source_keys": {
   "TDVIA:<slug>": "https://islamansiklopedisi.org.tr/<slug>",
   "WP:<title>": "https://en.wikipedia.org/wiki/<title>",
